classDiagram
    class Customer {
        -name : str
        -email : str
        -phone_number : str
        -purchase_history : List~Transaction~
        +add_purchase(transaction: Transaction) void
        +is_verified() bool
    }

    class Category {
        <<enumeration>>
        DESSERT
        DRINKS
        ENTREES
        APPETIZERS
        SNACKS
    }

    class FoodItem {
        -name : str
        -price : float
        -category : Category
        -popularity_rating : float
    }

    class Transaction {
        -customer : Customer
        -items : List~FoodItem~
        -payment_method : str
        +calculate_total() float
    }

    Customer "1" --> "0..*" Transaction : purchase_history
    Transaction "1" --> "1..*" FoodItem : items
    FoodItem "1" --> "1" Category : category
